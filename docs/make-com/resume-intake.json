{
  "name": "Sarah Fell - Resume Submission Intake",
  "description": "Receives resume submissions and creates candidate records in PocketBase",
  "scenario_version": "1",
  "modules": [
    {
      "id": "webhook1",
      "name": "Resume Form Webhook",
      "type": "webhook",
      "module": "make/webhooks",
      "version": "1",
      "parameters": {
        "name": "resume-intake-webhook",
        "location": "custom",
        "events": "default"
      },
      "output": {
        "schema": "resume-form-payload",
        "sample": {
          "kind": "resume",
          "firstName": "Jane",
          "lastName": "Doe",
          "email": "jane.doe@email.com",
          "phone": "+1234567890",
          "location": "Toronto, ON",
          "linkedinUrl": "https://linkedin.com/in/janedoe",
          "resumeUrl": "https://example.com/resume.pdf",
          "targetRole": "Operations Manager",
          "notes": "Open to contract and perm",
          "receivedAt": "2024-01-15T10:30:00Z",
          "source": "submit-resume"
        }
      }
    },
    {
      "id": "http1",
      "name": "Create Candidate in PocketBase",
      "type": "action",
      "module": "http/makeRequest",
      "version": "1",
      "parameters": {
        "method": "POST",
        "url": "https://YOUR_POCKETBASE_URL/api/collections/candidates/records",
        "headers": {
          "Content-Type": "application/json",
          "Authorization": "Bearer YOUR_POCKETBASE_ADMIN_TOKEN"
        },
        "body": {
          "name": "{{webhook1.firstName}} {{webhook1.lastName}}",
          "email": "{{webhook1.email}}",
          "phone": "{{webhook1.phone}}",
          "location": "{{webhook1.location}}",
          "linkedin_url": "{{webhook1.linkedinUrl}}",
          "resume_url": "{{webhook1.resumeUrl}}",
          "target_role": "{{webhook1.targetRole}}",
          "notes": "{{webhook1.notes}}",
          "status": "new",
          "source": "{{webhook1.source}}"
        },
        "serializeBody": true
      }
    },
    {
      "id": "email1",
      "name": "Send Confirmation to Candidate",
      "type": "action",
      "module": "gmail/sendEmail",
      "version": "1",
      "parameters": {
        "connection": "YOUR_GMAIL_CONNECTION_ID",
        "to": "{{webhook1.email}}",
        "subject": "Resume Received - Staffing Solutions by Sarah Fell",
        "body": "Hi {{webhook1.firstName}},\n\nThank you for submitting your resume. I've received it and will review it carefully.\n\nIf there's a fit for current or future opportunities, I'll be in touch.\n\nBest,\nSarah Fell\nStaffing Solutions by Sarah Fell"
      }
    },
    {
      "id": "email2",
      "name": "Notify Sarah of New Candidate",
      "type": "action",
      "module": "gmail/sendEmail",
      "version": "1",
      "parameters": {
        "connection": "YOUR_GMAIL_CONNECTION_ID",
        "to": "sarah.fell@staffingsolutionsbysarah.com",
        "subject": "New Candidate: {{webhook1.firstName}} {{webhook1.lastName}} - {{webhook1.targetRole}}",
        "body": "New resume submission:\n\nName: {{webhook1.firstName}} {{webhook1.lastName}}\nEmail: {{webhook1.email}}\nLocation: {{webhook1.location}}\nTarget Role: {{webhook1.targetRole}}\nLinkedIn: {{webhook1.linkedinUrl}}\nResume: {{webhook1.resumeUrl}}\n\nNotes: {{webhook1.notes}}\n\nView in PocketBase: https://YOUR_POCKETBASE_URL/_/#/collections/candidates"
      }
    }
  ],
  "connections": [
    {
      "id": "YOUR_GMAIL_CONNECTION_ID",
      "name": "Gmail",
      "service": "gmail",
      "type": "oauth2",
      "configured": false
    }
  ],
  "metadata": {
    "importInstructions": "1. Create webhook in Make.com\n2. Set up PocketBase and get your URL + admin token\n3. Configure Gmail for notifications\n4. Add webhook URL to website .env.local",
    "webhookUrl": "https://hook.make.com/YOUR_WEBHOOK_ID",
    "requiredSetup": ["PocketBase collection: candidates"],
    "version": "1.0.0",
    "createdBy": "Sarah Fell Website"
  }
}
