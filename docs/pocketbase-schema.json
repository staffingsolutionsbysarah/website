{
  "collections": [
    {
      "name": "candidates",
      "type": "base",
      "fields": [
        {
          "name": "name",
          "type": "text",
          "required": true,
          "options": { "min": 1, "max": 200 }
        },
        {
          "name": "email",
          "type": "email",
          "required": true
        },
        {
          "name": "phone",
          "type": "text",
          "options": { "max": 50 }
        },
        {
          "name": "location",
          "type": "text",
          "options": { "max": 200 }
        },
        {
          "name": "resume",
          "type": "file",
          "required": false,
          "options": {
            "maxSelect": 1,
            "maxSize": 10485760,
            "mimeTypes": ["application/pdf", "application/msword", "application/vnd.openxmlformats-officedocument.wordprocessingml.document"]
          }
        },
        {
          "name": "status",
          "type": "select",
          "required": true,
          "options": {
            "maxSelect": 1,
            "values": ["new", "screening", "interview", "offer", "hired", "rejected"],
            "castToString": true
          }
        },
        {
          "name": "source",
          "type": "select",
          "required": false,
          "options": {
            "maxSelect": 1,
            "values": ["website", "linkedin", "referral", "indeed", "ziprecruiter", "other"],
            "castToString": true
          }
        },
        {
          "name": "notes",
          "type": "editor",
          "required": false
        }
      ]
    },
    {
      "name": "employer_leads",
      "type": "base",
      "fields": [
        {
          "name": "company",
          "type": "text",
          "required": true,
          "options": { "min": 1, "max": 200 }
        },
        {
          "name": "contact",
          "type": "text",
          "required": true,
          "options": { "min": 1, "max": 200 }
        },
        {
          "name": "email",
          "type": "email",
          "required": true
        },
        {
          "name": "role",
          "type": "text",
          "required": false,
          "options": { "max": 200 }
        },
        {
          "name": "status",
          "type": "select",
          "required": true,
          "options": {
            "maxSelect": 1,
            "values": ["new", "contacted", "qualified", "proposal", "negotiating", "closed_won", "closed_lost"],
            "castToString": true
          }
        },
        {
          "name": "notes",
          "type": "editor",
          "required": false
        },
        {
          "name": "jobs",
          "type": "relation",
          "required": false,
          "options": {
            "collectionId": "_jobs_collection_id_",
            "cascadeDelete": false,
            "minSelect": null,
            "maxSelect": null,
            "displayFields": ["title"]
          }
        }
      ]
    },
    {
      "name": "jobs",
      "type": "base",
      "fields": [
        {
          "name": "title",
          "type": "text",
          "required": true,
          "options": { "min": 1, "max": 200 }
        },
        {
          "name": "location",
          "type": "text",
          "required": false,
          "options": { "max": 200 }
        },
        {
          "name": "type",
          "type": "select",
          "required": true,
          "options": {
            "maxSelect": 1,
            "values": ["full_time", "part_time", "contract", "temporary", "internship"],
            "castToString": true
          }
        },
        {
          "name": "summary",
          "type": "editor",
          "required": false
        },
        {
          "name": "active",
          "type": "bool",
          "required": true
        },
        {
          "name": "posted_at",
          "type": "date",
          "required": false
        },
        {
          "name": "employer",
          "type": "relation",
          "required": false,
          "options": {
            "collectionId": "_employer_leads_collection_id_",
            "cascadeDelete": false,
            "minSelect": null,
            "maxSelect": 1,
            "displayFields": ["company"]
          }
        }
      ]
    },
    {
      "name": "newsletter_subscribers",
      "type": "base",
      "fields": [
        {
          "name": "email",
          "type": "email",
          "required": true
        },
        {
          "name": "status",
          "type": "select",
          "required": true,
          "options": {
            "maxSelect": 1,
            "values": ["subscribed", "unsubscribed", "bounced"],
            "castToString": true
          }
        },
        {
          "name": "subscribed_at",
          "type": "date",
          "required": true
        }
      ]
    },
    {
      "name": "bookings",
      "type": "base",
      "fields": [
        {
          "name": "cal_id",
          "type": "text",
          "required": true,
          "options": { "min": 1, "max": 200 }
        },
        {
          "name": "attendee_name",
          "type": "text",
          "required": true,
          "options": { "min": 1, "max": 200 }
        },
        {
          "name": "attendee_email",
          "type": "email",
          "required": true
        },
        {
          "name": "event_title",
          "type": "text",
          "required": true,
          "options": { "min": 1, "max": 200 }
        },
        {
          "name": "event_time",
          "type": "date",
          "required": true
        },
        {
          "name": "status",
          "type": "select",
          "required": true,
          "options": {
            "maxSelect": 1,
            "values": ["confirmed", "cancelled", "completed", "no_show"],
            "castToString": true
          }
        },
        {
          "name": "notes",
          "type": "text",
          "required": false
        },
        {
          "name": "candidate",
          "type": "relation",
          "required": false,
          "options": {
            "collectionId": "_candidates_collection_id_",
            "cascadeDelete": false,
            "minSelect": null,
            "maxSelect": 1,
            "displayFields": ["name", "email"]
          }
        }
      ]
    }
  ]
}
