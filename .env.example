BOOKING_TIMEZONE=America/Toronto
BOOKING_SLOT_MINUTES=30
BOOKING_LEAD_HOURS=24
BOOKING_LOOKAHEAD_DAYS=14
BOOKING_WEEKLY_HOURS=MON=09:00-16:00;TUE=09:00-16:00;WED=09:00-16:00;THU=09:00-16:00;FRI=09:00-13:00
BOOKING_BLACKOUT_DATES=
BOOKING_RATE_LIMIT_MAX=6
BOOKING_RATE_LIMIT_WINDOW_MS=600000
BOOKING_NOTIFICATION_TO=Sarah.fell@staffingsolutionsbysarah.com
BOOKING_FROM_EMAIL=
BOOKING_REPLY_TO_EMAIL=
BOOKING_ALLOW_LOG_ONLY=true
RESEND_API_KEY=

# =============================================================================
# Make.com Webhooks
# =============================================================================
# Form submission endpoints from Make.com scenarios.
# Create scenarios in Make.com dashboard, add HTTP modules with webhook triggers,
# then paste the generated webhook URLs below.

# Contact form submissions (name, email, message, phone optional)
MAKE_WEBHOOK_CONTACT=https://hook.eu1.make.com/your-contact-webhook-id

# Resume upload submissions (name, email, phone, linkedin, file)
MAKE_WEBHOOK_RESUME=https://hook.eu1.make.com/your-resume-webhook-id

# Talent request form submissions (company, needs, timeline, contact)
MAKE_WEBHOOK_TALENT_REQUEST=https://hook.eu1.make.com/your-talent-request-webhook-id

# Cal.com webhook for scheduling confirmations (optional)
MAKE_WEBHOOK_CALENDLY=https://hook.eu1.make.com/your-calendly-webhook-id

# =============================================================================
# Cal.com
# =============================================================================
# Webhook secret for verifying Cal.com webhook payloads.
# Found in Cal.com dashboard under Webhooks > Advanced settings > Secret.
CAL_WEBHOOK_SECRET=

# =============================================================================
# PocketBase
# =============================================================================
# Self-hosted backend for form data storage (optional alternative to Make.com).
# Leave blank if not using PocketBase.

POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# =============================================================================
# Linear
# =============================================================================
# Issue tracking for recruiting pipeline and candidate management.
# Create an API key at linear.app/settings/api.

LINEAR_API_KEY=
LINEAR_TEAM_ID=

# =============================================================================
# Common Room
# =============================================================================
# Candidate engagement and talent intelligence platform.
# Create an API key at commonroom.io/settings/integrations.

COMMONROOM_API_KEY=
COMMONROOM_WORKSPACE_ID=
